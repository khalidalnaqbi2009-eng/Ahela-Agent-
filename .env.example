# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_SHEET_CSV_URL: The URL of the published CSV from the Google Sheet.
GOOGLE_SHEET_CSV_URL="https://docs.google.com/spreadsheets/d/e/2PACX-1vTGjIH3ak6Fz2zx8DClz84R05bCmJqVl4yM_g0tjkBK8rmu1SxBJVi_tC0kudU6EdU5UUatiWEklFs0/pub?output=csv"
